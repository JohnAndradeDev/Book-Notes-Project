<%- include("partials/header.ejs") %>
  <section>
    <a class="button" href="/logout" role="button">Log Out</a>

    <div class="containerBook">
      <div class="contentBook">
        <form action="/new" method="post">
          <div class="mb-4">
            <label class="pColor">Book Name</label>
            <textarea type="text" maxlength="100" name="bookname" class="textArea textName pColor" id="exampleInputEmail1" style="height: 3em;"></textarea>
          </div>
          <div class="mb-4">
            <label class="pColor">Opinion</label>
            <textarea type="text" maxlength="300" name="opinion" class="textArea" id="exampleInputPassword1"></textarea>
          </div>
          <button type="submit" class="button">Send</button>
        </form>
      </div>
    </div>

    <div class="containerReview">
      <h1 class="fontColor">Review of your books</h1>
      <% books.forEach((book)=> { %>
        <div class="contentReview">
          <form action="/delete" method="post">
            <input type="hidden" name="id" value="<%= book.id %>">
            <button class="button" type="submit">Delete</button>
          </form>
          <h3 class="fontColor">
            <%= book.title %>
          </h3>
          <p class="pColor">
            <%= book.date %>
          </p>
          <p class="pColor" id="opinion<%=book.id %>">
            <%= book.review %>
          </p>

          <form action="/update" method="post">
            <input type="hidden" name="updateBookId" value="<%= book.id %>">
            <textarea id="input<%=book.id %>" class="textArea" name="updateBookOpinion" value="<%=book.review %>" autocomplete="off" autofocus="true" hidden="true"><%=book.review %></textarea>
            <button id="done<%=book.id%>" class="button padBut" type="submit" hidden>ok</button>
          </form>
          <button id="edit<%=book.id%>" class="button" onclick="handler('<%=book.id%>')">Update</button>
        </div>
        <% }); %>
    </div>

  </section>

  <script>
    function handler(id) {
      document.getElementById("opinion" + id).setAttribute("hidden", true)
      document.getElementById("edit" + id).setAttribute("hidden", true)
      document.getElementById("done" + id).removeAttribute("hidden")
      document.getElementById("input" + id).removeAttribute("hidden")
    }
  </script>


  <%- include("partials/footer.ejs") %>