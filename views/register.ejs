<%- include('partials/header') %>
  <div class="container">
    <h1>Register</h1>
    <div class="container forms">
      <form action="/register" method="POST">
        <div class="mb-4">
          <label for="email" class="mb-2 bungee-regular">Email</label>
          <input type="email" class="form-control" name="username">
        </div>
        <div class="mb-4">
          <label for="password" class="mb-2 bungee-regular">Password</label>
          <input type="password" class="form-control" name="password" autocomplete="off">
        </div>
        <button type="submit" class="btn btn-light bungee-regular">Register</button>
      </form>
    </div>
  </div>

  </div>
  </div>

  <%- include('partials/footer') %>